{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "JSON Schema for Office Add-in Actions File",
    "description": "A file describing the data format for the Office.js actions referenced by an Office Add-in's actionFile property.",
    "type": "object",
    "properties": {
        "$schema": {
            "title": "Schema",
            "description": "The Office actions JSON schema file.",
            "type": "string"
        },
        "actions": {
            "title": "Actions",
            "description": "The Office.js actions of this file. Each id must match an action in the manifest.",
            "type": "array",
            "items": {
                "$ref": "#/definitions/action"
            },
            "minItems": 1
        }
    },
    "required": [
        "actions"
    ],
    "additionalProperties": false,
    "definitions": {
        "action": {
            "title": "Action",
            "description": "An action that invokes a command and retrieves data.",
            "type": "object",
            "properties": {
                "id": {
                    "title": "Action ID",
                    "description": "The unique ID of the action. Matches the manifest's action id.",
                    "type": "string",
                    "maxLength": 64
                },
                "description": {
                    "title": "Description",
                    "description": "Describes what the action does and when to use it.",
                    "type": "string"
                },
                "parameters": {
                    "$ref": "#/definitions/parameters"
                },
                "returns": {
                    "$ref": "#/definitions/returns"
                },
                "states": {
                    "$ref": "#/definitions/states"
                }
            },
            "required": [
                "id",
                "description"
            ],
            "additionalProperties": false
        },
        "parameters": {
            "title": "Parameters",
            "description": "The parameters that can be passed to the action.",
            "type": "object",
            "properties": {
                "type": {
                    "title": "Type",
                    "description": "The JSON Schema type.",
                    "type": "string",
                    "const": "object"
                },
                "properties": {
                    "title": "Properties",
                    "description": "The parameter definitions, keyed by name.",
                    "type": "object",
                    "patternProperties": {
                        "^[A-Za-z0-9_]+$": {
                            "$ref": "#/definitions/parameter"
                        }
                    }
                },
                "required": {
                    "title": "Required parameters",
                    "description": "The names of the required parameters.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "type",
                "properties"
            ],
            "additionalProperties": false
        },
        "parameter": {
            "title": "Parameter",
            "description": "Describes a single action parameter.",
            "type": "object",
            "properties": {
                "type": {
                    "title": "Type",
                    "description": "Specifies the parameter's type.",
                    "type": "string",
                    "enum": [
                        "string",
                        "boolean",
                        "integer",
                        "number"
                    ]
                },
                "description": {
                    "title": "Description",
                    "description": "The description of the parameter.",
                    "type": "string"
                },
                "default": {
                    "title": "Default",
                    "description": "The default value for an optional parameter.",
                    "type": [
                        "string",
                        "boolean",
                        "integer",
                        "number"
                    ]
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "returns": {
            "title": "Returns",
            "description": "The value returned by the action.",
            "type": "object",
            "properties": {
                "type": {
                    "title": "Type",
                    "description": "The type of the returned value.",
                    "type": "string",
                    "enum": [
                        "string"
                    ]
                },
                "description": {
                    "title": "Description",
                    "description": "The description of the return value.",
                    "type": "string"
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "states": {
            "title": "States",
            "description": "Per-state instructions for the Copilot orchestrator.",
            "type": "object",
            "properties": {
                "reasoning": {
                    "$ref": "#/definitions/stateConfig",
                    "description": "The state where the model can call actions."
                },
                "responding": {
                    "$ref": "#/definitions/stateConfig",
                    "description": "The state where the model responds to the user."
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "stateConfig": {
            "title": "State configuration",
            "description": "Instructions for the action in this orchestrator state.",
            "type": "object",
            "properties": {
                "description": {
                    "title": "Description",
                    "description": "The purpose of the action in this state.",
                    "type": "string"
                }
            },
            "required": [
                "description"
            ],
            "additionalProperties": false
        }
    }
}
