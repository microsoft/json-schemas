{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "JSON Schema for an Office Add-in Action File",
    "description": "A file describing the data format for a single Office.js action referenced by an Office Add-in's actionFile property.",
    "type": "object",
    "properties": {
        "$schema": {
            "title": "ActionSchema",
            "description": "The URI/URL of this schema, which should always be https://developer.microsoft.com/json-schemas/office-js/action.schema.json",
            "type": "string"
        },
        "id": {
            "title": "Action ID",
            "description": "The ID of the action, which must match an action ID in the manifest.",
            "type": "string",
            "maxLength": 64
        },
        "actionDescription": {
            "title": "Action Description",
            "description": "Describes what the action does and when to use it.",
            "type": "string"
        },
        "parameters": {
            "$ref": "#/definitions/parameters"
        },
        "returnedValue": {
            "$ref": "#/definitions/returnedValue"
        },
        "states": {
            "$ref": "#/definitions/states"
        }
    },
    "required": [
        "id",
        "actionDescription"
    ],
    "additionalProperties": false,
    "definitions": {
        "parameters": {
            "title": "Parameters",
            "description": "The parameters that can be passed to the action.",
            "type": "object",
            "properties": {
                "type": {
                    "title": "Type",
                    "description": "The JSON Schema type.",
                    "type": "string",
                    "const": "object"
                },
                "properties": {
                    "title": "Properties",
                    "description": "The parameter definitions, keyed by name.",
                    "type": "object",
                    "patternProperties": {
                        "^[A-Za-z0-9_]+$": {
                            "$ref": "#/definitions/parameter"
                        }
                    },
                    "additionalProperties": false
                },
                "required": {
                    "title": "Required parameters",
                    "description": "The names of the required parameters.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "type",
                "properties"
            ],
            "additionalProperties": false
        },
        "parameter": {
            "title": "Parameter",
            "description": "Describes a single action parameter.",
            "type": "object",
            "properties": {
                "type": {
                    "title": "Type",
                    "description": "Specifies the parameter's type.",
                    "type": "string",
                    "enum": [
                        "string",
                        "boolean",
                        "integer",
                        "number"
                    ]
                },
                "description": {
                    "title": "Description",
                    "description": "The description of the parameter.",
                    "type": "string"
                },
                "default": {
                    "title": "Default",
                    "description": "The default value for an optional parameter.",
                    "type": [
                        "string",
                        "boolean",
                        "integer",
                        "number"
                    ]
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "returnedValue": {
            "title": "Returned Value",
            "description": "The value returned by the action.",
            "type": "object",
            "properties": {
                "dataType": {
                    "title": "Return Value Data Type",
                    "description": "The type of the returned value.",
                    "type": "string",
                    "enum": [
                        "string"
                    ]
                },
                "returnedValueDescription": {
                    "title": "Returned Value Description",
                    "description": "The description of the returned value.",
                    "type": "string"
                }
            },
            "required": [
                "dataType"
            ],
            "additionalProperties": false
        },
        "states": {
            "title": "States",
            "description": "Per-state instructions for the Copilot orchestrator.",
            "type": "object",
            "properties": {
                "reasoning": {
                    "$ref": "#/definitions/stateConfig",
                    "description": "The state where the model can call actions."
                },
                "responding": {
                    "$ref": "#/definitions/stateConfig",
                    "description": "The state where the model responds to the user."
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "stateConfig": {
            "title": "State configuration",
            "description": "Instructions for the action in this orchestrator state.",
            "type": "object",
            "properties": {
                "description": {
                    "title": "Description",
                    "description": "The purpose of the action in this state.",
                    "type": "string"
                }
            },
            "required": [
                "description"
            ],
            "additionalProperties": false
        }
    }
}
