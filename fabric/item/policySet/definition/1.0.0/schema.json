{
  "$id": "https://developer.microsoft.com/json-schemas/fabric/item/policySet/definition/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "PolicySet",
  "type": "object",
  "properties": {
    "properties": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false
    },
    "policyRules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/policyRule"
      }
    }
  },
  "required": [
    "properties",
    "policyRules"
  ],
  "additionalProperties": false,
  "definitions": {
    "policyRule": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "policy": {
          "type": "string",
          "enum": [
            "ExternalDataSharing",
            "ItemCreation"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/effect"
          }
        }
      },
      "required": [
        "displayName",
        "policy",
        "conditions",
        "effects"
      ],
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/definitions/staticCondition"
        },
        {
          "$ref": "#/definitions/dynamicCondition"
        }
      ]
    },
    "staticCondition": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Static"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "dynamicCondition": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Dynamic"
        },
        "targetProperty": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "predicate": {
          "$ref": "#/definitions/predicate"
        }
      },
      "required": [
        "type",
        "targetProperty",
        "predicate"
      ],
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "AnyOf",
            "NoneOf"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "operator",
        "values"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Allow"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
