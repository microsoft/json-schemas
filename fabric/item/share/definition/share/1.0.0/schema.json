{
  "$id": "https://developer.microsoft.com/json-schemas/fabric/item/share/definition/share/1.0.0/schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Defines the schema for the IQShare ALM definition, describing which Fabric items are shared with which recipients under which policies.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "const": "https://developer.microsoft.com/json-schemas/fabric/item/share/definition/share/1.0.0/schema.json"
    },
    "assets": {
      "description": "The list of Fabric items being shared.",
      "type": "array",
      "minItems": 1,
      "maxItems": 999,
      "items": {
        "$ref": "https://developer.microsoft.com/json-schemas/fabric/item/share/definition/common/1.0.0/schema.json#/definitions/Asset"
      }
    },
    "recipients": {
      "description": "The list of recipients the assets are shared with.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "https://developer.microsoft.com/json-schemas/fabric/item/share/definition/common/1.0.0/schema.json#/definitions/Recipient"
      }
    },
    "sharePolicies": {
      "description": "The list of policies governing the share.",
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "https://developer.microsoft.com/json-schemas/fabric/item/share/definition/common/1.0.0/schema.json#/definitions/ShareExpirationPolicy"
      }
    }
  },
  "required": ["$schema", "assets", "recipients"]
}
