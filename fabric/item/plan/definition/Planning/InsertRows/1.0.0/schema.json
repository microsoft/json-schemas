{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://developer.microsoft.com/json-schemas/fabric/item/plan/definition/Planning/InsertRows/1.0.0/schema.json",
  "title": "Insert Rows",
  "description": "Array of custom (inserted) rows for a Planning visual, including static rows and calculated rows.",
  "type": "object",
  "required": [
    "$schema",
    "rows"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "const": "https://developer.microsoft.com/json-schemas/fabric/item/plan/definition/Planning/InsertRows/1.0.0/schema.json"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/InsertRow"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "InsertRow": {
      "type": "object",
      "required": [
        "id",
        "visualId",
        "rowMeta",
        "name",
        "dimensionId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique row identifier."
        },
        "visualId": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the visual this row belongs to."
        },
        "visualRowConfigId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional visual row configuration reference."
        },
        "rowPath": {
          "type": ["string", "null"],
          "description": "Optional hierarchical path for the row."
        },
        "derivedFromRowId": {
          "type": ["string", "null"],
          "description": "Optional source row ID when row is derived."
        },
        "rowMeta": {
          "$ref": "#/definitions/RowMeta"
        },
        "name": {
          "type": "string",
          "description": "Display name of the row."
        },
        "dimensionId": {
          "type": "string",
          "description": "Dimension this row belongs to."
        },
        "status": {
          "type": ["string", "integer"],
          "description": "Row status."
        }
      },
      "additionalProperties": true
    },
    "RowMeta": {
      "type": "object",
      "required": [
        "id",
        "row_type",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "row_type": {
          "$ref": "#/definitions/RowType"
        },
        "title": {
          "type": "string"
        },
        "scaling_factor": {
          "type": ["string", "null"],
          "description": "Scaling factor for display (e.g., Auto)."
        },
        "include_in_total": {
          "type": "boolean"
        },
        "parent_id": {
          "type": "string",
          "description": "Parent row ID for hierarchy."
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "previous_row_id": {
          "type": "string",
          "description": "ID of the preceding row for ordering."
        },
        "disabled": {
          "type": "boolean"
        },
        "bind_for_cross_filter": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "column_aggregation": {
          "type": ["string", "null"],
          "enum": ["Sum", "Average", "Min", "Max", "Count", null]
        }
      },
      "additionalProperties": true
    },
    "RowType": {
      "type": "object",
      "description": "Discriminated union of row types. Exactly one key should be present.",
      "properties": {
        "StaticRow": {
          "$ref": "#/definitions/StaticRowType"
        },
        "CalculatedRow": {
          "$ref": "#/definitions/CalculatedRowType"
        },
        "ForecastRow": {
          "$ref": "#/definitions/ForecastRow"
        },
        "PercentContributionRow": {
          "$ref": "#/definitions/PercentContributionRow"
        }
      },
      "oneOf": [
        { "required": ["StaticRow"] },
        { "required": ["CalculatedRow"] },
        { "required": ["ForecastRow"] },
        { "required": ["PercentContributionRow"] }
      ],
      "additionalProperties": true
    },
    "StaticRowType": {
      "type": "object",
      "properties": {
        "distribute_parent_value_to_child": {
          "type": "boolean"
        },
        "default_value": {
          "type": "object",
          "description": "Default value configuration.",
          "additionalProperties": true
        },
        "row_edit_mode": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "CalculatedRowType": {
      "type": "object",
      "properties": {
        "formula": {
          "type": ["string", "object"],
          "description": "Calculation formula for this row."
        },
        "description": { "type": "string" },
        "include_in_chart": { "type": "boolean" },
        "deferred": { "type": ["boolean", "string", "null"] },
        "bind_for_cross_filter": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "ForecastRow": {
      "type": "object",
      "additionalProperties": true
    },
    "PercentContributionRow": {
      "type": ["object", "string"],
      "additionalProperties": true
    }
  }
}